rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: orders
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (optional) - ID of the user who placed the order
    //   - items: list (required) - Items purchased
    //   - shippingMethod: string (optional) - Selected shipping method
    //   - shippingCost: number (optional) - Cost of shipping
    //   - payer: map (required) - Customer details
    //   - status: string (required) - Order status ('pending', 'paid', etc.)
    //   - createdAt: timestamp (required) - When the order was created
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'crivisquisofia@gmail.com';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function isValidOrder(data) {
      return hasRequiredFields(['items', 'payer', 'status', 'createdAt']) &&
             data.items is list && data.items.size() > 0 &&
             data.payer is map &&
             data.status in ['pending', 'paid', 'shipped', 'cancelled'] &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /orders/{orderId} {
      // Allow anyone to create an order (guest checkout) as long as it's valid
      allow create: if isValidOrder(request.resource.data);
      
      // Only allow reading if the user owns the order or is admin
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Allow admin to update status
      allow update: if isAdmin();
      
      allow delete: if false;
    }
  }
}
